# Dashboard settings (Vite). Copy to .env.local, which is not committed. Only VITE_ values reach the browser:
# never put a secret here.
# true = live mode against the Wethaq API (npm run dev:live sets it); unset or false = the self-contained demonstration.
# VITE_WETHAQ_LIVE=true
# Where the API is when it is on another origin, for example https://api.example.edu (empty = same origin, /api).
# The API must then allow the dashboard's origin with CORS_ORIGIN. See docs/gp482/DEPLOYMENT_GUIDE.md.
# VITE_API_URL=
