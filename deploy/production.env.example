# Settings for deploy/compose.yml. Copy to deploy/production.env (git-ignored), fill in, and keep it private.
# Never commit real values. Generate secrets with: openssl rand -hex 32

# Required. Hex characters only, so the value can sit inside DATABASE_URL without escaping.
POSTGRES_PASSWORD=
# Required. A random value of at least 32 characters.
JWT_SECRET=
# Required. The public domain name of the server (automatic HTTPS), or http://:80 for a local check.
WETHAQ_SITE_ADDRESS=

# Optional.
# JWT_TTL=8h
# TEMP_PASSWORD_HOURS=24
# LOG_LEVEL=info
# LEDGER_MODE=fabric
# WEB_HTTP_PORT=80
# WEB_HTTPS_PORT=443
# Where the live-mode dashboard build is (VITE_WETHAQ_LIVE=true npx vite build --outDir dist-live).
# DASHBOARD_DIR=../dist-live
# The Fabric test network's organizations folder and the API's enrolled identities.
# FABRIC_ORGANIZATIONS_DIR=../fabric/fabric-samples/test-network/organizations
# FABRIC_IDENTITY_HOST_DIR=../fabric/identities
# FABRIC_DOCKER_NETWORK=fabric_test
# Base images, for example a registry mirror when Docker Hub limits pulls.
# NODE_IMAGE=node:22-bookworm-slim
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2
# API_IMAGE=wethaq-api:latest
