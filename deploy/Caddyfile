# Caddy configuration for deploy/compose.yml: the live-mode dashboard and /api on one origin.
# WETHAQ_SITE_ADDRESS is a domain name (automatic HTTPS) or http://:80 (plain HTTP, local checks only).
{$WETHAQ_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# The hash allows the theme script inlined in index.html; update it if that script changes
		# (node deploy/check-csp-hash.mjs checks it; e2e-deploy/csp.spec.ts checks the page).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-FyLB8HewowGpjHcA0THpcA+5C3U/rqeuzEGMdVLuZsc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		# flush_interval -1 passes the live updates (/api/events, server-sent events) through without buffering.
		reverse_proxy {$WETHAQ_API_UPSTREAM:api:4000} {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
