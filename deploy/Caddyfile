# Caddy configuration for deploy/compose.yml: the live-mode dashboard and /api on one origin.
# WETHAQ_SITE_ADDRESS is a domain name (automatic HTTPS) or http://:80 (plain HTTP, local checks only).
{$WETHAQ_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		# flush_interval -1 passes the live updates (/api/events, server-sent events) through without buffering.
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
