# Copy to .env and adjust. .env is not committed.
PORT=4000
DATABASE_URL=postgres://wethaq:wethaq@127.0.0.1:5433/wethaq
# Use a long random value in any shared or hosted environment (at least 32 characters in production).
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=8h
# Password given to the seeded demonstration accounts (planner@, dispatcher@, receiver@, admin@wethaq.demo).
DEMO_PASSWORD=demo
# Allow the dashboard's demo role switcher (signs in as the seeded account of the chosen role).
DEMO_ROLE_SWITCH=true
# local = development ledger in PostgreSQL (no Fabric); fabric = Hyperledger Fabric test network (stage 3).
LEDGER_MODE=local
# Only needed when the dashboard is served from another origin (for example a hosted deployment).
# CORS_ORIGIN=https://wethaqksu.vercel.app
