# Copy to .env and adjust. .env is not committed.
PORT=4000
DATABASE_URL=postgres://wethaq:wethaq@127.0.0.1:5434/wethaq
# Use a long random value in any shared or hosted environment (at least 32 characters in production).
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=8h
# Hours before a temporary password issued by an administrator stops working.
TEMP_PASSWORD_HOURS=24
# Password given to the seeded demonstration accounts (planner@, dispatcher@, receiver@, admin@wethaq.demo).
DEMO_PASSWORD=demo
# Allow the dashboard's demo role switcher (signs in as the seeded account of the chosen role).
DEMO_ROLE_SWITCH=true
# local = development ledger in PostgreSQL (no Fabric); fabric = Hyperledger Fabric test network (see ../fabric/README.md).
LEDGER_MODE=local
# Fabric settings (only used when LEDGER_MODE=fabric; these are the defaults)
# FABRIC_TEST_NETWORK=../fabric/fabric-samples/test-network
# FABRIC_CHANNEL=wethaq
# FABRIC_CHAINCODE=wethaq
# FABRIC_ORG1_ENDPOINT=localhost:7051
# FABRIC_ORG2_ENDPOINT=localhost:9051
# Only needed when the dashboard is served from another origin (for example a hosted deployment).
# CORS_ORIGIN=https://wethaqksu.vercel.app
# Demonstration tools (POST /demo/invalid). Always off when NODE_ENV=production.
# DEMO_TOOLS=true
# Synchronization with the ledger: reconcile unconfirmed transactions every 30 s; a transaction id the ledger still
# does not know after 5 minutes is marked as not committed.
# RECONCILE_INTERVAL_MS=30000
# PENDING_EXPIRY_MS=300000
# Fabric identity of the API (created by ../fabric/enroll-identities.sh) and time limits in milliseconds.
# FABRIC_IDENTITY_DIR=../fabric/identities
# FABRIC_APP_USER=wethaq-app
# FABRIC_COMMIT_TIMEOUT_MS=60000
# Log level: debug | info | warn | error | silent
# LOG_LEVEL=info
